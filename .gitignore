# --- Base de Datos Vectorial Nativa (ChromaDB) ---
# Ocultamos la persistencia en disco para que no se suban los embeddings de prueba
backend/data/vector_store/

# --- Datasets Binarios Generados ---
# Los archivos .npy ocupan espacio y se regeneran con el script
scripts/finetune/dataset/*.npy
scripts/finetune/dataset/*.png

# --- Modelos y Escaladores Entrenados ---
# (Opcional) Si deseas trackear tus pesos .keras en Git puedes comentar las líneas de abajo,
# pero al ser archivos binarios grandes, la buena práctica es ignorarlos.
backend/data/models/*.keras
backend/data/models/*.pkl
backend/data/models/

# --- Archivos de Caché de Python ---
**/__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

